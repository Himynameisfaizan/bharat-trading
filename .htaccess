# =====================================================================
#  .htaccess  -  BHARAT TRADING
#  Clean URLs, redirects from old URLs, security and speed.
#  Works in a sub-folder (http://localhost/projects/bharat-trading/) and at a domain root.
#
#  Requirements: Apache 2.4 (or LiteSpeed) with mod_rewrite, and  AllowOverride All
#  (XAMPP and Hostinger already have both).
#  If you get a 500 error, comment out the sections one by one to find the cause.
# =====================================================================

Options -Indexes
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>
DirectoryIndex index.php index.html
ServerSignature Off
AddDefaultCharset UTF-8


# ---------------------------------------------------------------------
#  1. URL REWRITING
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On

# Only if the rules below do not work in your sub-folder, enable this line and put your folder path:
# RewriteBase /projects/bharat-trading/


# --- 1.1  Protect folders that must never be opened from the browser -----------------
RewriteRule ^(config|includes|cache)(/|$) - [F,L,NC]

# --- 1.2  Never run PHP files from the uploads folders -------------------------------
RewriteRule ^(admin/)?uploads/.*\.(php[0-9]?|phtml|phar)$ - [F,L,NC]


# --- 1.3  Force HTTPS on the live server (skipped automatically on localhost) --------
#          Comment these 4 lines out if the live site has no SSL certificate yet.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|[^.]+\.local)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- 1.4  Optional: send www.example.com to example.com (remove the # signs to enable)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]


# --- 1.5  OLD URLS  ->  NEW URLS  (301 redirects, so Google keeps the ranking) -------
#          They only fire for the address typed in the browser (THE_REQUEST), so there is no loop.

# product-details.php?slug=Peanut%20Kernels   ->  /product/Peanut%20Kernels
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^\s?]*/)?)product-details\.php\?(?:[^\s]*&)?slug=([^&\s]+)
RewriteRule ^ %1product/%2? [NE,R=301,L]

# blog-details.php?slug=my-article   ->  /blog/my-article
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^\s?]*/)?)blog-details\.php\?(?:[^\s]*&)?slug=([^&\s]+)
RewriteRule ^ %1blog/%2? [NE,R=301,L]

# products.php?category=dry-fruits-nuts   ->  /category/dry-fruits-nuts
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^\s?]*/)?)products\.php\?category=([^&\s]+)\sHTTP/
RewriteRule ^ %1category/%2? [NE,R=301,L]

# page.php?slug=export-team   ->  /page/export-team   (pages made in the admin panel)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^\s?]*/)?)page\.php\?(?:[^\s]*&)?slug=([^&\s]+)
RewriteRule ^ %1page/%2? [NE,R=301,L]

# location.php   ->  /locations
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^\s?]*/)?)location\.php(?:[?\s])
RewriteRule ^ %1locations [NE,R=301,L]

# about.php, contact.php, products.php, blog.php, privacy-policy.php ...   ->  /about, /contact, /products, /blog, /privacy-policy ...
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^\s?]*/)?)(about|contact|products|blog|privacy-policy|terms-condition|refund-policy|shipping-return)\.php(?:[?\s])
RewriteRule ^ %1%2 [NE,R=301,L]

# index.php   ->  /
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^\s?]*/)?)index\.php(?:[?\s])
RewriteRule ^ %1 [NE,R=301,L]

# /about/  ->  /about   (no trailing slash on pages; real folders are left alone)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^\s?]*[^/\s?])/+(?:\?[^\s]*)?\sHTTP/
RewriteRule ^(.+)/$ %1 [NE,R=301,L]


# --- 1.6  CLEAN URLS  ->  real files (internal, the address bar does not change) -----
RewriteRule ^sitemap\.xml$                 sitemap.php                          [L]

RewriteRule ^product/([^/]+)/?$            product-details.php?slug=$1          [B,L,QSA]
RewriteRule ^blog/([^/]+)/?$               blog-details.php?slug=$1             [B,L,QSA]
RewriteRule ^category/([^/]+)/?$           products.php?category=$1             [B,L,QSA]
RewriteRule ^page/([^/]+)/?$               page.php?slug=$1                     [B,L,QSA]
RewriteRule ^(product|category)/?$         products.php                         [L]
RewriteRule ^(page|locations)/?$           location.php                         [L]

RewriteRule ^(about|contact|products|blog|privacy-policy|terms-condition|refund-policy|shipping-return)/?$   $1.php   [L,QSA]


# --- 1.7  404 PAGE: an address that is not a real file or folder and matched no rule above ---
#          (missing images, CSS and similar files keep the plain server 404 so the site stays fast)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(?:jpe?g|png|gif|webp|avif|svg|ico|css|js|map|woff2?|ttf|eot|otf|pdf|xml|txt|json|mp4|webm|zip|rar)$ [NC]
RewriteRule ^ 404.php [L]

</IfModule>


# ---------------------------------------------------------------------
#  2. SECURITY
# ---------------------------------------------------------------------
# Hidden files and files that must not be downloaded
<IfModule mod_authz_core.c>
<FilesMatch "(^\.|\.(sql|log|bak|ini|inc|sh|md|lock|dist|yml|yaml|env|swp)$|^composer\.(json|lock)$)">
    Require all denied
</FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header unset X-Powered-By
    # Turn this on only after the live site works on HTTPS:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>


# ---------------------------------------------------------------------
#  3. SPEED  (compression and browser caching)
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 week"
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType application/xml           "access plus 1 hour"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType image/avif                "access plus 6 months"
    ExpiresByType image/gif                 "access plus 6 months"
    ExpiresByType image/svg+xml             "access plus 6 months"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>
